---
const title = "Vecto | Open-source Vector Processing";
const description = "An open-source tool bridging local databases with AI agents.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: #FAFAFA;
        color: #111111;
        line-height: 1.6;
        margin: 0;
        padding: 0;
      }
      main {
        max-width: 720px;
        margin: 8rem auto;
        padding: 0 2rem;
      }
      h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
      pre { background-color: #1A1A1A; color: #F8F8F2; padding: 1.5rem; border-radius: 6px; }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>Vecto</h1>
        <p>An open-source tool bridging local databases with AI agents.</p>
        <p><a href="https://github.com/DanielMevit/Vecto">View Repository on GitHub</a></p>
      </header>

      <section>
        <h2>Quick Start</h2>
        <pre><code>git clone https://github.com/DanielMevit/Vecto.git
cd Vecto
npm install
npm run start</code></pre>
      </section>
    </main>
  </body>
</html>
